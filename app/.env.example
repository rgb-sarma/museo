# Where the FastAPI backend lives.
#
# Web preview (npm run dev): the default localhost value is fine — leave this unset.
# Android device or emulator: the webview has its own localhost, so point this at
# your machine's LAN IP and run uvicorn with --host 0.0.0.0.
#
# Copy to .env.local and edit.
VITE_API_URL=http://192.168.1.20:8000
