{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "museo-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "app"],
      "port": 5173
    },
    {
      "name": "museo-api",
      "runtimeExecutable": "backend/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
